# =============================================================================
#  Copy this file to `.env` in the same folder and fill in real values.
#
#      cp .env.example .env          (Git Bash)
#      Copy-Item .env.example .env   (PowerShell)
#
#  `.env` is git-ignored and must never be committed.
#  `run.ps1` loads this file into the environment before starting the backend.
# =============================================================================

# --- Database (REQUIRED) -----------------------------------------------------
# Create the schema and user first:
#   CREATE DATABASE ecommerce_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'ecomuser'@'localhost' IDENTIFIED BY 'your-password-here';
#   GRANT ALL PRIVILEGES ON ecommerce_db.* TO 'ecomuser'@'localhost';
#   FLUSH PRIVILEGES;
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=ecomuser
DB_PASSWORD=

# --- JWT signing key (REQUIRED) ----------------------------------------------
# Must be at least 32 characters. The app refuses to start without it.
# Generate one:  openssl rand -base64 48
APP_JWT_SECRET=
# Token lifetime in milliseconds (86400000 = 24 hours)
APP_JWT_EXPIRATION_MS=86400000

# --- Bootstrap administrator -------------------------------------------------
# Used once, on an empty database, to create the first admin account.
# If ADMIN_PASSWORD is blank, no admin is created (no insecure default is used).
ADMIN_EMAIL=admin@ecommerce.local
ADMIN_PASSWORD=
ADMIN_FULL_NAME=System Administrator
ADMIN_PHONE=+919999999999

# --- CORS --------------------------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
# 5173 is the Vite dev server; 4173 is `vite preview`.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Twilio WhatsApp (OPTIONAL) ----------------------------------------------
# Leave WHATSAPP_ENABLED=false to run without a Twilio account. Order events will
# still be generated and stored in the `notifications` table with status SKIPPED,
# and the exact message body is written to the application log.
#
# To send real messages:
#   1. Sign up at https://www.twilio.com/try-twilio
#   2. Open Console > Messaging > Try it out > Send a WhatsApp message
#   3. Join the sandbox by sending the given "join <phrase>" code from your phone
#   4. Copy the Account SID and Auth Token below, set WHATSAPP_ENABLED=true
#
# Note: with the sandbox, each recipient must join before they can be messaged.
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_CONTENT_SID=

# --- Email / OTP Delivery (OPTIONAL) ----------------------------------------
# Option A: Brevo HTTPS REST API (Recommended on Render / cloud - never blocked):
#   1. Get your free API key at https://app.brevo.com/settings/keys/api
#   2. Set BREVO_API_KEY and your verified sender email in MAIL_FROM:
BREVO_API_KEY=
MAIL_FROM=no-reply@rozbazaar.local
MAIL_FROM_NAME=Roz Bazaar

# Option B: Standard SMTP (for local development or unblocked cloud hosts):
# When BREVO_API_KEY is empty and MAIL_HOST is empty, OTP emails are logged to console.
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Server ------------------------------------------------------------------
SERVER_PORT=8080

